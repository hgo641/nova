<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="org.example.nova.robot.mapper.RobotMapper">


    <select id="findByApartmentId" resultType="org.example.nova.robot.dto.ElevatorResponse">
        SELECT
            elevator_id,
            apartment_id,
            dong,
            hogi
        FROM elevator
        WHERE
            apartment_id = #{apartmentId}
    </select>

    <insert id="createElevator" parameterType="org.example.nova.robot.dto.ElevatorRequest">

        INSERT INTO elevator (apartment_id, dong, hogi)
        VALUES (#{apartmentId}, #{dong}, #{hogi})

    </insert>

</mapper>
